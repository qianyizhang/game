{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "trace-visualizer/build.mjs",
    "export-card-art.mjs",
    "review-card-art.mjs",
    "scaffold-card-art.mjs",
    "card-art-catalogue.tsx",
    "compare-playtests.mjs",
    "solve-challenges.mjs",
    "hearth-agent.mjs",
    "hearth-arena-agent.mjs",
    "hearth-runtime.mjs"
  ]
}
