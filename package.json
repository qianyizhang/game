{
  "name": "card-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --project application --maxWorkers=1",
    "test:watch": "vitest --project application --maxWorkers=1",
    "test:geometry": "vitest run --project geometry",
    "test:browser": "playwright test --project=functional --project=requires-blender --project=requires-private-evidence",
    "test:browser:smoke": "playwright test --project=smoke",
    "test:browser:native": "playwright test --project=requires-blender",
    "test:browser:private": "playwright test --project=requires-private-evidence",
    "test:browser:review": "playwright test --project=visual-review",
    "check": "npm run check:maintenance && npm run test && npm run playtest",
    "check:full": "npm run check && npm run test:geometry",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playtest": "vitest run --config vitest.playtest.config.ts",
    "assets:export": "node packages/workshop-tools/art/export.ts",
    "assets:bake": "node packages/workshop-tools/art/bake-studies.ts",
    "assets:check": "node packages/workshop-tools/art/bake-studies.ts --check",
    "assets:gallery": "node packages/workshop-tools/art/gallery.ts",
    "assets:scaffold": "node packages/workshop-tools/art/scaffold.ts",
    "assets:review": "node packages/workshop-tools/art/review.ts",
    "playtest:compare": "node packages/workshop-tools/experiments/compare-playtests.ts",
    "engine:challenges": "node packages/workshop-tools/experiments/solve-challenges.ts",
    "engine:hearth": "node packages/workshop-tools/hearth/agent.ts",
    "engine:night-passage": "node packages/workshop-tools/night-passage/cli.ts",
    "experiment:hearth": "node packages/workshop-tools/hearth/experiment.ts",
    "dcc": "node packages/dcc-workbench/cli.ts",
    "test:dcc": "node --test packages/dcc-workbench/*.test.mjs",
    "test:dcc:native": "node packages/dcc-workbench/verify-native.ts",
    "test:dcc:runtime": "node packages/dcc-workbench/verify-runtime.ts",
    "maintenance": "node packages/workshop-tools/cli.mjs",
    "lint:tools": "eslint packages/workshop-tools packages/dcc-workbench/src packages/dcc-workbench/evaluation packages/dcc-workbench/subjects/canid/*.ts \"packages/dcc-workbench/*.{ts,mjs}\" eslint.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:tools": "npm run test --workspace @card-workshop/tools",
    "check:python": "uv run --locked ruff check && uv run --locked ruff format --check && uv run --locked mypy && uv run --locked python -m unittest discover -s packages/dcc-workbench/blender -p \"test_*.py\"",
    "format:maintenance": "npm run format:check && npm run maintenance -- check",
    "check:maintenance": "npm run format:maintenance && npm run lint:tools && npm run lint:app && npm run typecheck && npm run check:python && npm run test:tools && npm run test:dcc && npm run build",
    "lint:app": "eslint src tests packages/diablo2 *.config.ts --max-warnings=0",
    "test:dcc:saved": "node packages/dcc-workbench/verify-saved.ts",
    "test:diablo2": "npm run test --workspace @card-workshop/diablo2",
    "dcc:canid": "node packages/dcc-workbench/canid.ts",
    "dcc:otter": "node packages/dcc-workbench/otter.ts",
    "dcc:raven": "node packages/dcc-workbench/raven.ts",
    "dcc:boar": "node packages/dcc-workbench/boar.ts",
    "dcc:fox": "node packages/dcc-workbench/fox.ts",
    "engine:policy": "node packages/workshop-tools/policy/cli.ts",
    "ci": "node packages/workshop-tools/ci/cli.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/dcc-workbench",
    "packages/workshop-tools",
    "packages/diablo2"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0"
}
