{
  "name": "card-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:trace": "node --test packages/workshop-tools/trace/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run check:maintenance && npm run format:check && npm run test && npm run playtest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playtest": "vitest run --config vitest.playtest.config.ts",
    "assets:export": "node packages/workshop-tools/art/export.ts",
    "assets:scaffold": "node packages/workshop-tools/art/scaffold.ts",
    "assets:review": "node packages/workshop-tools/art/review.ts",
    "playtest:compare": "node packages/workshop-tools/experiments/compare-playtests.ts",
    "engine:challenges": "node packages/workshop-tools/experiments/solve-challenges.ts",
    "engine:hearth": "node packages/workshop-tools/hearth/agent.ts",
    "experiment:hearth": "node packages/workshop-tools/hearth/experiment.ts",
    "dcc": "node packages/dcc-workbench/pipeline.mjs",
    "test:dcc": "node --test packages/dcc-workbench/*.test.mjs",
    "test:dcc:native": "node packages/dcc-workbench/verify-native.ts",
    "maintenance": "node packages/workshop-tools/cli.mjs",
    "lint:tools": "eslint packages/session-review packages/workshop-tools packages/dcc-workbench/src \"packages/dcc-workbench/*.{ts,mjs}\" eslint.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:tools": "npm run test --workspace @card-workshop/tools",
    "check:python": "uv run --locked ruff check && uv run --locked ruff format --check && uv run --locked mypy && uv run --locked python -m unittest discover -s packages/dcc-workbench/blender -p \"test_*.py\"",
    "format:maintenance": "prettier --check packages/session-review packages/workshop-tools packages/dcc-workbench/README.md packages/dcc-workbench/src packages/dcc-workbench/package.json packages/dcc-workbench/tsconfig.json docs/README.md docs/guide docs/engineering docs/art docs/research maintenance .github AGENTS.md package.json eslint.config.mjs src tests *.config.ts tsconfig.json \"packages/dcc-workbench/*.{ts,mjs,json}\" packages/dcc-workbench/subjects packages/diablo2",
    "check:maintenance": "npm run format:maintenance && npm run lint:tools && npm run lint:app && npm run typecheck && npm run check:python && npm run test:tools && npm run test:dcc && npm run maintenance -- check && npm run build",
    "trace:build": "node packages/workshop-tools/trace/build.ts",
    "lint:app": "eslint src tests packages/diablo2 *.config.ts --max-warnings=0",
    "test:dcc:saved": "node packages/dcc-workbench/verify-saved.ts",
    "usage:dashboard": "node packages/workshop-tools/usage/build.ts",
    "test:usage": "node --test packages/workshop-tools/usage/*.test.ts",
    "test:diablo2": "npm run test --workspace @card-workshop/diablo2"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "workspaces": [
    "packages/dcc-workbench",
    "packages/workshop-tools",
    "packages/session-review",
    "packages/diablo2"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0"
}
